# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=splitfool

# Origin users open the app from. In dev, Vite (5173) proxies /api to this server.
PUBLIC_URL=http://localhost:5173
# Extra allowed browser origins, comma separated (optional)
CORS_ORIGINS=
# Reverse proxy hops in front of the API (set to 1 behind a single load balancer)
TRUST_PROXY=0

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COOKIE_SECRET=
ACCESS_TOKEN_SECRET=

# OAuth providers (a provider is hidden until both values are set)
# Google: https://console.cloud.google.com/apis/credentials  (Web application client)
#   Authorized redirect URI: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers  (OAuth App)
#   Callback URL: <PUBLIC_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare Turnstile secret (required in production; optional in dev)
TURNSTILE_SECRET_KEY=

# Email (optional in dev — an Ethereal test inbox is used when unset)
SMTP_URL=
MAIL_FROM=splitFool <no-reply@splitfool.local>

ANDROID_REDIRECT_URI=splitfool://auth
